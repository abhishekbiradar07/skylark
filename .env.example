# Monday.com Configuration
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_DEALS_BOARD_ID=your_deals_board_id_here
MONDAY_WORK_ORDERS_BOARD_ID=your_work_orders_board_id_here

# LLM Configuration - Using Groq (OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# Application Configuration
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Optional: API Rate Limiting
MONDAY_API_RATE_LIMIT=100
MONDAY_API_RATE_PERIOD=60
